# 复制为 .env 后按需修改： cp .env.example .env
# 本文件及 .env 均已被 .dockerignore / .gitignore 排除，不会进入构建上下文或版本库。

# ── 镜像与容器名 ──────────────────────────────────────────────
EASY_PROXIES_IMAGE=easy_proxies:3.3.0-ext
EASY_PROXIES_CONTAINER=easy_proxies_ext
PROXY_POOL_IMAGE=jhao104/proxy_pool:latest
PROXY_POOL_CONTAINER=proxy_pool_ext
REDIS_IMAGE=redis:7-alpine
REDIS_CONTAINER=proxy_redis_ext

# ── 端口映射（bridge 默认；改 host 模式时这些变量不生效）────────
PROXY_PORT=2323
MGMT_PORT=9091
MULTIPORT_RANGE=24000-24200
PROXY_POOL_PORT=5010

# ── 运行身份（Linux 建议设为本机 uid:gid，需在 compose 中启用 user）─
UID=1000
GID=1000
TZ=Asia/Shanghai

# ── proxy_pool ────────────────────────────────────────────────
PROXY_POOL_DB_CONN=redis://@proxy-redis:6379/0
PROXY_POOL_TABLE=use_proxy
PROXY_POOL_MIN=20

# ── 网络测绘凭据：自行填写，切勿写入 compose 或提交真实值 ────────
# 内置预设默认引用：fofa→FOFA_KEY，hunter→HUNTER_API_KEY，quake→QUAKE_TOKEN
# 自定义来源在 data/config.yaml 的 mapping.providers[].auth.key_env 中引用对应变量名
MAPPING_API_KEY=
FOFA_KEY=
FOFA_EMAIL=            # 仅 FOFA 旧账号需要（key+email），现代 key-only 账号留空
HUNTER_API_KEY=
SHODAN_API_KEY=
QUAKE_TOKEN=
ZOOMEYE_API_KEY=

# ── 运行时出站代理（build 阶段不使用）─────────────────────────
# 容器内 127.0.0.1 指向容器自身；如需走宿主机代理请用 host.docker.internal
# OUTBOUND_PROXY=http://host.docker.internal:7897
OUTBOUND_PROXY=
NO_PROXY=proxy-pool,proxy-redis,localhost,127.0.0.1

# 注意：管理面板密码不在本文件，请在 data/config.yaml 的 management.password 设置。
